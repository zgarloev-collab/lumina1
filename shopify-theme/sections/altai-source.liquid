{% render 'altai-assets' %}

{%- assign source_alt = 'Dark glossy shilajit resin seeping from an ancient mountain rock crevice surrounded by wild Siberian herbs' -%}
{%- if section.settings.image.alt != blank -%}
  {%- assign source_alt = section.settings.image.alt -%}
{%- endif -%}

<section class="altai-section altai-section--dark altai-pad" id="altai-source-{{ section.id }}" aria-labelledby="altai-source-title-{{ section.id }}">
  <div class="altai-container">
    <div class="altai-split{% if section.settings.reverse %} altai-split--reverse{% endif %}">
      <div class="altai-split__media" data-altai-reveal>
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 50vw, 100vw',
              widths: '600, 900, 1200, 1400',
              alt: source_alt
          }}
        {%- else -%}
          <img src="{{ 'altai-source.png' | asset_url }}" alt="{{ source_alt | escape }}" width="1200" height="1500" loading="lazy">
        {%- endif -%}
        {%- if section.settings.badge_value != blank -%}
          <p class="altai-split__badge">
            <strong>{{ section.settings.badge_value | escape }}</strong>
            {{ section.settings.badge_label | escape }}
          </p>
        {%- endif -%}
      </div>

      <div class="altai-split__body" data-altai-reveal style="--altai-delay: 0.15s">
        {%- if section.settings.eyebrow != blank -%}
          <p class="altai-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="altai-heading altai-h2" id="altai-source-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        <div class="altai-rte">{{ section.settings.text }}</div>

        <ul class="altai-split__stats" role="list" style="list-style:none">
          {%- for i in (1..3) -%}
            {%- liquid
              assign value_key = 'stat_' | append: i | append: '_value'
              assign label_key = 'stat_' | append: i | append: '_label'
            -%}
            {%- if section.settings[value_key] != blank -%}
              <li>
                <strong>{{ section.settings[value_key] | escape }}</strong>
                <span>{{ section.settings[label_key] | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if section.settings.button_label != blank -%}
          <a class="altai-btn altai-btn--outline" href="{{ section.settings.button_link | default: '/pages/about' }}">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Altai · The Source",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the bundled resin image." },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "text", "id": "badge_value", "label": "Image badge value", "default": "Altai, Siberia" },
    { "type": "text", "id": "badge_label", "label": "Image badge label", "default": "50.4° N · 86.6° E" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Source" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Born in <em>the Rocks</em>" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>High in the Altai Mountains, where the air thins and glaciers carve the stone, a rare resin forms over centuries. Ancient alpine plants decompose deep inside rock crevices, compressed by mountain pressure and slowly enriched by mineral-laden glacial waters.</p><p>Each summer, as the sun warms the cliffs, the resin seeps to the surface. We harvest it by hand above 3,000 meters, then gently purify it with cold glacial water — preserving centuries of mountain intelligence to fuel modern lives.</p>"
    },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "300+ yrs" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "To form" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "3,000 m" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Altitude" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "Hand" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Harvested" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our Story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Altai · The Source" }]
}
{% endschema %}
