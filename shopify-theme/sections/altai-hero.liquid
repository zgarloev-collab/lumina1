{% render 'altai-assets' %}

{%- assign cta_url = section.settings.button_link | default: routes.all_products_collection_url -%}
{%- assign hero_alt = 'Snow-capped Altai mountain peaks above a turquoise glacial river in morning mist' -%}
{%- if section.settings.image.alt != blank -%}
  {%- assign hero_alt = section.settings.image.alt -%}
{%- endif -%}

<section class="altai-section altai-hero" id="altai-hero-{{ section.id }}" aria-labelledby="altai-hero-title-{{ section.id }}">
  <div class="altai-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000, 2400',
          alt: hero_alt
      }}
    {%- else -%}
      <img
        src="{{ 'altai-hero.png' | asset_url }}"
        alt="{{ hero_alt | escape }}"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="altai-container altai-hero__inner">
    <div class="altai-hero__content" data-altai-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="altai-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="altai-heading altai-h1" id="altai-hero-title-{{ section.id }}">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="altai-lede">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <ul class="altai-hero__usps" aria-label="Key benefits">
        {%- if section.settings.usp_1 != blank -%}<li>{{ section.settings.usp_1 | escape }}</li>{%- endif -%}
        {%- if section.settings.usp_2 != blank -%}<li>{{ section.settings.usp_2 | escape }}</li>{%- endif -%}
        {%- if section.settings.usp_3 != blank -%}<li>{{ section.settings.usp_3 | escape }}</li>{%- endif -%}
      </ul>

      <div class="altai-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="altai-btn" href="{{ cta_url }}">
            {{ section.settings.button_label | escape }}
            {% render 'altai-icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="altai-link" href="{{ section.settings.secondary_link | default: '#altai-ritual' }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <ul class="altai-hero__trust" role="list">
        {%- for i in (1..3) -%}
          {%- liquid
            assign value_key = 'stat_' | append: i | append: '_value'
            assign label_key = 'stat_' | append: i | append: '_label'
            assign stat_value = section.settings[value_key]
            assign stat_label = section.settings[label_key]
          -%}
          {%- if stat_value != blank -%}
            <li>
              <strong>{{ stat_value | escape }}</strong>
              {{ stat_label | escape }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Altai · Hero",
  "tag": "div",
  "class": "altai-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Leave empty to use the bundled Altai mountain image." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium Purified Siberian Mineral Resin" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Raw mountain energy. <em>Unbroken focus.</em>" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading", "default": "Leave daily fatigue in the valley. Altai Shilajit delivers 85+ trace minerals and naturally rich fulvic acid, hand-harvested from rock crevices above 3,000 meters." },
    { "type": "header", "content": "Benefit pills" },
    { "type": "text", "id": "usp_1", "label": "Benefit 1", "default": "85+ trace minerals" },
    { "type": "text", "id": "usp_2", "label": "Benefit 2", "default": "Rich in fulvic acid" },
    { "type": "text", "id": "usp_3", "label": "Benefit 3", "default": "Harvested at 3,000+ m" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop Pure Resin" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Discover the ritual" },
    { "type": "text", "id": "secondary_link", "label": "Secondary link (URL or #anchor)", "default": "#altai-ritual" },
    { "type": "header", "content": "Stats" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "85+" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Trace minerals" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "3,000 m" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Harvest altitude" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "100%" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Lab-certified resin" }
  ],
  "presets": [{ "name": "Altai · Hero" }]
}
{% endschema %}
