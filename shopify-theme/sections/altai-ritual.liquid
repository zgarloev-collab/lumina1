{% render 'altai-assets' %}

{%- assign cta_url = section.settings.button_link | default: routes.all_products_collection_url -%}

<section class="altai-section altai-pad" id="altai-ritual" aria-labelledby="altai-ritual-title-{{ section.id }}">
  <div class="altai-container">
    <header class="altai-section-head" data-altai-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="altai-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="altai-heading altai-h2" id="altai-ritual-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="altai-lede">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <ol class="altai-steps">
      {%- for block in section.blocks -%}
        <li class="altai-step" {{ block.shopify_attributes }} data-altai-reveal style="--altai-delay: {{ forloop.index0 | times: 0.12 }}s">
          <span class="altai-step__num" aria-hidden="true">0{{ forloop.index }}</span>
          <h3 class="altai-heading altai-h3">{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.meta != blank -%}
            <span class="altai-step__meta">{{ block.settings.meta | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.note != blank -%}
      <div class="altai-ritual__note" data-altai-reveal>
        <p>{{ section.settings.note }}</p>
        {%- if section.settings.button_label != blank -%}
          <a class="altai-btn" href="{{ cta_url }}">
            {{ section.settings.button_label | escape }}
            {% render 'altai-icon', name: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Altai · Daily Ritual",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Daily Ritual" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Sixty seconds to <em>golden energy</em>" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading", "default": "A simple morning ritual, practised in the mountains for centuries." },
    { "type": "inline_richtext", "id": "note", "label": "Closing note", "default": "One jar. Sixty mornings of steady, mineral-rich energy." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Pure Resin" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Measure" },
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Take a pea-sized portion of resin from the jar." },
        { "type": "text", "id": "meta", "label": "Detail", "default": "≈ 300 mg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Altai · Daily Ritual",
      "blocks": [
        { "type": "step", "settings": { "title": "Measure" } },
        { "type": "step", "settings": { "title": "Dissolve" } },
        { "type": "step", "settings": { "title": "Sip & Rise" } }
      ]
    }
  ]
}
{% endschema %}
